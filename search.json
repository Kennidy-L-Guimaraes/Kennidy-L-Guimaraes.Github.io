---
permalink: /search.json
---
[{% for a in site.articles %}{"title":{{ a.title | jsonify }},"cat":{{ a.categories | join: ', ' | jsonify }},"lang":{{ a.lang | default: site.default_lang | jsonify }},"url":{{ a.url | relative_url | jsonify }},"text":{{ a.content | strip_html | strip_newlines | truncate: 3000 | jsonify }}}{% unless forloop.last %},{% endunless %}{% endfor %}]