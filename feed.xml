---
layout: null
permalink: /feed.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.title | xml_escape }}</title>
    <link>{{ '/' | absolute_url }}</link>
    <description>{{ site.tagline | xml_escape }}</description>
    <language>{{ site.default_lang | default: 'en' }}</language>
    <lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>
    <atom:link href="{{ '/feed.xml' | absolute_url }}" rel="self" type="application/rss+xml" />
{%- assign all = site.articles | sort: 'date' | reverse -%}
{%- assign count = 0 -%}
{%- for a in all -%}
  {%- assign al = a.lang | default: site.default_lang -%}
  {%- if al == site.default_lang and count < 20 -%}
    {%- assign count = count | plus: 1 %}
    <item>
      <title>{{ a.title | xml_escape }}</title>
      <link>{{ a.url | absolute_url }}</link>
      <guid isPermaLink="true">{{ a.url | absolute_url }}</guid>
      <pubDate>{{ a.date | date_to_rfc822 }}</pubDate>
      {%- for c in a.categories %}
      <category>{{ c | xml_escape }}</category>
      {%- endfor %}
      <description>{{ a.description | default: a.excerpt | strip_html | strip_newlines | truncatewords: 50 | xml_escape }}</description>
    </item>
  {%- endif -%}
{%- endfor %}
  </channel>
</rss>